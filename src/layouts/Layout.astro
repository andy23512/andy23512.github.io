---
interface Props {
	title?: string;
	description?: string;
	path?: string;
}

const {
	title = "Tangent's Star Chart",
	description = "A catalog of Tangent's unofficial CharaChorder web tools, apps, and browser extensions — a few named after stars, on an interactive celestial sphere.",
	path = '/',
} = Astro.props;

const url = `https://andy23512.github.io${path}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | andy23512 on GitHub</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={url} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://andy23512.github.io/og.jpg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://andy23512.github.io/og.jpg" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		/* Deep sky backdrop the celestial sphere is drawn on. */
		background:
			radial-gradient(
				ellipse at 50% 45%,
				oklch(0.28 0.05 265) 0%,
				oklch(0.16 0.03 265) 55%,
				oklch(0.11 0.02 265) 100%
			),
			#0b1020;
	}
</style>
