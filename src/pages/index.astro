---
import '@/styles/global.css';
import CelestialSphere from '../components/CelestialSphere.astro';
import StarfieldBackdrop from '../components/StarfieldBackdrop.astro';
import Layout from '../layouts/Layout.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
interface Page {
	title: string;
	description: string;
	/** A single-destination card is the link itself; the whole card is clickable. */
	url?: string;
	/** A multi-destination card (e.g. an extension on Chrome + Firefox) renders
	 *  these as buttons instead of being one link. */
	links?: { label: string; url: string }[];
	/** Small tag next to the title marking what kind of thing this is. */
	badge?: string;
	/** Key of the star this project is named after, see src/data/stars.ts */
	star?: string;
}

const pageGroup: { name: string; pages: Page[] }[] = [
	{
		name: 'Web Tools',
		pages: [
			{
				title: 'Blog',
				description: 'Unofficial CharaChorder and Forge notes and articles, with a Traditional Chinese version linked inside',
				url: 'https://andy23512.github.io/blog/',
			},
			{
				title: 'Alnitak',
				description: 'An unofficial practice tool tailored for CharaChorder 3D input devices',
				url: 'https://andy23512.github.io/alnitak/',
				star: 'alnitak',
			},
			{
				title: 'Alnilam',
				description: 'An unofficial practice tool tailored for CharaChorder Lite',
				url: 'https://andy23512.github.io/alnilam/',
				star: 'alnilam',
			},
			{
				title: 'Castor',
				description: 'An unofficial viewer for seeing a CharaChorder device at its real, physical size on your screen',
				url: 'https://andy23512.github.io/castor/',
				star: 'castor',
			},
			{
				title: 'CCOS Meta Viewer',
				description: 'An unofficial data viewer for the official CharaChorder Firmware Meta API',
				url: 'https://andy23512.github.io/ccos-meta-viewer/',
			},
			{
        title: 'Chara',
				description: 'An unofficial chord practice tool tailored for CharaChorder 3D input devices',
				url: 'https://andy23512.github.io/chara/',
				star: 'chara',
			},
			{
				title: 'Chara Chronus',
				description: 'An unofficial chronicle for CharaChorder',
				url: 'https://andy23512.github.io/chara-chronus/',
			},
			{
				title: 'Chorder\'s Almanac',
				description: 'An unofficial daily almanac for CharaChorder users, with a date-seeded Do / Don\'t, a fortune, and moments from typing history',
				url: 'https://andy23512.github.io/chorder-almanac/',
			},
			{
				title: 'Device Comparator',
				description: 'An unofficial website for comparing the differences between the specs of CharaChorder devices',
				url: 'https://andy23512.github.io/device-comparator/',
			},
			{
				title: 'TanChord Code',
				description: 'An unofficial, experimental editor that allows you to edit the chord library of your CharaChorder device, similar to editing code in a code editor',
				url: 'https://andy23512.github.io/tccode/',
			}
		]
	},
	{
		name: 'Apps & Extensions',
		pages: [
			{
				title: 'Sirius',
				description: 'An unofficial cross-platform desktop layout viewer and key tester for CharaChorder 3D that lights up the keys you press in real time',
				badge: 'app',
				star: 'sirius',
				links: [
					{
						label: 'Download',
						url: 'https://github.com/andy23512/sirius/releases',
					},
					{
						label: 'GitHub',
						url: 'https://github.com/andy23512/sirius',
					},
				],
			},
			{
				title: 'Keybr CC Extension',
				description: 'An unofficial browser extension for showing the layout of CharaChorder 3D input devices on Keybr',
				badge: 'extension',
				links: [
					{
						label: 'Chrome',
						url: 'https://chromewebstore.google.com/detail/keybr-cc-extension/fdofhfbipdhkkhhdjlfjnjfnkibpbdpg',
					},
					{
						label: 'Firefox',
						url: 'https://addons.mozilla.org/en-US/firefox/addon/keybr-cc-extension/',
					},
				],
			},
			{
				title: 'Monkeytype CC Extension',
				description: 'An unofficial browser extension for showing the layout of CharaChorder 3D input devices on Monkeytype',
				badge: 'extension',
				links: [
					{
						label: 'Chrome',
						url: 'https://chromewebstore.google.com/detail/monkeytype-cc-extension/mhfjhmegecimjbohhdbflkhdfnaadple',
					},
					{
						label: 'Firefox',
						url: 'https://addons.mozilla.org/en-US/firefox/addon/monkeytype-cc-extension/',
					},
				],
			},
		]
	}
]
---

<Layout>
	<StarfieldBackdrop />
	<div class="text-white h-screen flex flex-col">
		<div class="px-4 py-2 bg-gray-900/80 backdrop-blur-sm flex-none flex flex-col sm:flex-row sm:items-center sm:gap-2">
			<h1 class="text-2xl whitespace-nowrap">
				Tangent's Star Chart
			</h1>
			<span class="hidden sm:inline">-</span>
			<h2 class="text-lg">
				Unofficial CharaChorder web tools, apps, and extensions — a few named after stars
			</h2>
		</div>
		<div class="flex-1 min-h-0 flex flex-col lg:flex-row">
			<div class="flex-none h-[34vh] lg:h-auto lg:w-2/5 xl:w-1/2">
				<CelestialSphere />
			</div>
			<div class="flex-1 min-h-0 overflow-auto">
			{
				pageGroup.map(group => (
					<div class="p-4">
						<h3 class="text-xl mb-2">{group.name}</h3>
						<div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
							{
								group.pages
									.slice()
									.sort((a, b) => a.title.localeCompare(b.title))
									.map(page =>
									page.links ? (
										<div
											data-star={page.star}
											class="project-card block p-4 rounded data-[star]:hover:ring-2 data-[star]:hover:ring-yellow-300/70"
										>
											<h4 class="text-lg font-semibold mb-1">
												{page.title}
												{page.star && (
													<span
														class="ml-1 align-middle text-sm text-yellow-300/80"
														title="Named after a star"
													>
														✦<span class="sr-only"> (named after a star)</span>
													</span>
												)}
												{page.badge && (
													<span class="ml-2 align-middle rounded border border-blue-300/40 px-1.5 py-0.5 text-[11px] font-medium uppercase tracking-wide text-blue-200/80">
														{page.badge}
													</span>
												)}
											</h4>
											<p class="text-sm">{page.description}</p>
											<div class="mt-3 flex flex-wrap gap-2">
												{page.links.map(link => (
													<a
														href={link.url}
														target="_blank"
														class="inline-flex items-center rounded bg-gray-600/60 px-2.5 py-1 text-xs font-medium transition hover:bg-gray-500/70 focus-visible:ring-2 focus-visible:ring-blue-300/70"
													>
														{link.label}
													</a>
												))}
											</div>
										</div>
									) : (
										<a
											href={page.url}
											target="_blank"
											data-star={page.star}
											class="project-card block p-4 rounded data-[star]:hover:ring-2 data-[star]:hover:ring-yellow-300/70 data-[star]:focus-visible:ring-2 data-[star]:focus-visible:ring-yellow-300/70"
										>
											<h4 class="text-lg font-semibold mb-1">
												{page.title}
												{page.star && (
													<span
														class="ml-1 align-middle text-sm text-yellow-300/80"
														title="Named after a star"
													>
														✦<span class="sr-only"> (named after a star)</span>
													</span>
												)}
											</h4>
											<p class="text-sm">{page.description}</p>
										</a>
									)
								)
							}
						</div>
					</div>
				))
			}
			</div>
		</div>
	</div>
</Layout>

<style>
	.project-card {
		position: relative;
		overflow: hidden;
		background-color: color-mix(in oklab, var(--color-gray-700) 70%, transparent);
		backdrop-filter: blur(4px);
		transition:
			background-color 0.3s,
			backdrop-filter 0.3s;
	}

	/* Pointing at a card clears it, opening a window onto the starfield behind
	   the page. Kept next to the ::before light so the whole effect lives in
	   one place. */
	.project-card:hover,
	.project-card:focus-visible {
		background-color: color-mix(in oklab, var(--color-gray-700) 10%, transparent);
		backdrop-filter: none;
	}

	/* A soft light trailing the cursor across the card being pointed at. */
	.project-card::before {
		content: '';
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.3s;
		background: radial-gradient(
			18rem circle at var(--pointer-x, 50%) var(--pointer-y, 50%),
			rgba(191, 219, 254, 0.22),
			transparent 70%
		);
	}

	.project-card:hover::before,
	.project-card:focus-visible::before {
		opacity: 1;
	}

	/* Keep the title and description above the light. */
	.project-card > * {
		position: relative;
	}
</style>

<script>
	for (const card of document.querySelectorAll<HTMLElement>('.project-card')) {
		card.addEventListener('pointermove', (event) => {
			const rect = card.getBoundingClientRect();
			card.style.setProperty('--pointer-x', `${event.clientX - rect.left}px`);
			card.style.setProperty('--pointer-y', `${event.clientY - rect.top}px`);
		});
	}
</script>
