---
import '@/styles/global.css';
import Layout from '../layouts/Layout.astro';
import { pages } from '../data/projects.ts';
import { stars } from '../data/stars.ts';

const projectByStarKey = new Map(pages.filter((p) => p.star).map((p) => [p.star as string, p]));

const namedStars = stars
	.filter((s) => s.key)
	.map((s) => ({ star: s, project: projectByStarKey.get(s.key as string) }))
	.sort((a, b) => (a.project?.title ?? '').localeCompare(b.project?.title ?? ''));
---

<Layout
	title="Naming Stories"
	description="Why each of Tangent's unofficial CharaChorder tools is named after its star."
	path="/stars"
>
	<div class="text-white min-h-screen">
		<div class="px-4 py-3 bg-gray-900/80 backdrop-blur-sm flex items-center gap-2">
			<h1 class="text-2xl">Naming Stories</h1>
			<a href="/" class="ml-auto text-sm text-blue-200/80 transition hover:text-blue-100">&larr; Back to star chart</a>
		</div>
		<div class="max-w-3xl mx-auto p-4 flex flex-col gap-4">
			{
				namedStars.map(({ star, project }) => (
					<div id={star.key} class="rounded bg-gray-700/40 p-4 scroll-mt-16">
						<h2 class="text-lg font-semibold">
							{project?.title ?? star.key}
							<span class="ml-2 align-middle text-sm text-yellow-300/80">
								✦{project?.title !== star.name && ` ${star.name}`}
							</span>
						</h2>
						<p class="mt-2 text-sm text-gray-200">{star.origin ?? 'Origin story coming soon.'}</p>
					</div>
				))
			}
		</div>
	</div>
</Layout>
