---
// A rotating 3D celestial sphere drawn on a canvas, used as the page backdrop.
// Hovering a project named after a star (elements carrying `data-star`) spins the
// sphere until that star sits at the centre, and lights it up.
---

<div class="relative h-full w-full">
	<canvas id="celestial-sphere" class="block h-full w-full" aria-hidden="true"
	></canvas>
	<p
		id="celestial-sphere-caption"
		class="pointer-events-none absolute inset-x-0 bottom-2 text-center text-xs text-blue-200/50 transition-opacity"
	>
		Some of my projects are named after stars — hover one to find it here, or
		click a lit star to jump to its project.
	</p>
</div>

<script>
	import { constellationLines, starByKey, stars } from '@/data/stars';
	import type { Star } from '@/data/stars';

	const canvas = document.getElementById(
		'celestial-sphere',
	) as HTMLCanvasElement | null;
	const ctx = canvas?.getContext('2d');
	if (canvas && ctx) {
		const D2R = Math.PI / 180;
		const starByName = new Map(
			stars.filter((s) => s.name).map((s) => [s.name as string, s]),
		);

		// Faint background stars, deterministic so the sky never reshuffles.
		let seed = 20240512;
		const random = () => {
			seed = (seed * 1664525 + 1013904223) % 4294967296;
			return seed / 4294967296;
		};
		const backgroundStars: Star[] = Array.from({ length: 900 }, () => ({
			ra: random() * 24,
			dec: Math.asin(random() * 2 - 1) / D2R,
			mag: 4.5 + random() * 2.5,
		}));

		// Camera: the sky coordinates currently facing the viewer.
		let lon = 5.6 * 15;
		let lat = 0;
		let targetLon = lon;
		let targetLat = lat;
		let highlight: Star | null = null;
		let glow = 0;
		let drifting = true;

		// With reduced motion the sphere never drifts or eases: it jumps straight
		// to the star being pointed at, and only repaints when something changed.
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let dirty = true;

		let width = 0;
		let height = 0;
		let cx = 0;
		let cy = 0;
		let radius = 0;

		function resize() {
			const dpr = window.devicePixelRatio || 1;
			const rect = canvas!.getBoundingClientRect();
			width = rect.width;
			height = rect.height;
			canvas!.width = Math.round(width * dpr);
			canvas!.height = Math.round(height * dpr);
			ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
			cx = width / 2;
			cy = height / 2;
			radius = Math.min(width, height) * 0.42;
			dirty = true;
		}

		/** Orthographic projection of a sky position onto the sphere. */
		function project(raHours: number, dec: number) {
			const a = (raHours * 15 - lon) * D2R;
			const d = dec * D2R;
			const cl = Math.cos(lat * D2R);
			const sl = Math.sin(lat * D2R);
			const x = Math.cos(d) * Math.cos(a);
			const y = Math.cos(d) * Math.sin(a);
			const z = Math.sin(d);
			return {
				x: cx + radius * y,
				y: cy - radius * (z * cl - x * sl),
				depth: x * cl + z * sl,
			};
		}

		function starRadius(mag: number) {
			return Math.max(0.5, (6.6 - mag) * 0.42) * (radius / 320);
		}

		function drawSphereGrid() {
			for (const front of [false, true]) {
				ctx!.strokeStyle = front
					? 'rgba(125, 178, 255, 0.16)'
					: 'rgba(125, 178, 255, 0.05)';
				ctx!.lineWidth = 1;
				const arcs: { ra: number; dec: number }[][] = [];
				for (let raDeg = 0; raDeg < 360; raDeg += 30) {
					const arc = [];
					for (let dec = -90; dec <= 90; dec += 3) {
						arc.push({ ra: raDeg / 15, dec });
					}
					arcs.push(arc);
				}
				for (let dec = -60; dec <= 60; dec += 30) {
					const arc = [];
					for (let raDeg = 0; raDeg <= 360; raDeg += 3) {
						arc.push({ ra: raDeg / 15, dec });
					}
					arcs.push(arc);
				}
				for (const arc of arcs) {
					ctx!.beginPath();
					let drawing = false;
					for (const point of arc) {
						const p = project(point.ra, point.dec);
						if (p.depth > 0 !== front) {
							drawing = false;
							continue;
						}
						if (drawing) ctx!.lineTo(p.x, p.y);
						else ctx!.moveTo(p.x, p.y);
						drawing = true;
					}
					ctx!.stroke();
				}
			}

			ctx!.strokeStyle = 'rgba(147, 197, 253, 0.28)';
			ctx!.lineWidth = 1.5;
			ctx!.beginPath();
			ctx!.arc(cx, cy, radius, 0, Math.PI * 2);
			ctx!.stroke();
		}

		function drawConstellations() {
			for (const line of constellationLines) {
				// The figure the highlighted star belongs to lights up with it.
				const lit = highlight?.name ? line.includes(highlight.name) : false;
				ctx!.strokeStyle = lit
					? `rgba(253, 224, 71, ${0.15 + 0.45 * glow})`
					: 'rgba(148, 190, 255, 0.28)';
				ctx!.lineWidth = lit ? 1.4 : 1;
				ctx!.beginPath();
				let drawing = false;
				for (const name of line) {
					const star = starByName.get(name);
					if (!star) {
						drawing = false;
						continue;
					}
					const p = project(star.ra, star.dec);
					if (p.depth <= 0) {
						drawing = false;
						continue;
					}
					if (drawing) ctx!.lineTo(p.x, p.y);
					else ctx!.moveTo(p.x, p.y);
					drawing = true;
				}
				ctx!.stroke();
			}
		}

		function drawStars(list: Star[], front: boolean) {
			for (const star of list) {
				const p = project(star.ra, star.dec);
				if (p.depth > 0 !== front) continue;
				const r = starRadius(star.mag);
				// Stars near the limb are seen edge on, so fade them out.
				const alpha = front
					? 0.35 + 0.65 * Math.min(1, Math.abs(p.depth) * 2.2)
					: 0.08;
				ctx!.fillStyle = `rgba(226, 240, 255, ${alpha})`;
				ctx!.beginPath();
				ctx!.arc(p.x, p.y, r, 0, Math.PI * 2);
				ctx!.fill();
			}
		}

		function drawHighlight() {
			if (!highlight || glow <= 0.01) return;
			const p = project(highlight.ra, highlight.dec);
			if (p.depth <= 0) return;
			const pulse = reducedMotion.matches
				? 1
				: 1 + 0.12 * Math.sin(performance.now() / 320);
			const r = Math.max(4, starRadius(highlight.mag)) * 1.6 * pulse;

			const halo = ctx!.createRadialGradient(p.x, p.y, 0, p.x, p.y, r * 7);
			halo.addColorStop(0, `rgba(253, 224, 71, ${0.55 * glow})`);
			halo.addColorStop(0.35, `rgba(250, 204, 21, ${0.18 * glow})`);
			halo.addColorStop(1, 'rgba(250, 204, 21, 0)');
			ctx!.fillStyle = halo;
			ctx!.beginPath();
			ctx!.arc(p.x, p.y, r * 7, 0, Math.PI * 2);
			ctx!.fill();

			ctx!.fillStyle = `rgba(255, 251, 235, ${glow})`;
			ctx!.beginPath();
			ctx!.arc(p.x, p.y, r, 0, Math.PI * 2);
			ctx!.fill();

			ctx!.strokeStyle = `rgba(253, 224, 71, ${0.7 * glow})`;
			ctx!.lineWidth = 1.5;
			ctx!.beginPath();
			ctx!.arc(p.x, p.y, r * 3.4 * pulse, 0, Math.PI * 2);
			ctx!.stroke();

			if (highlight.name) {
				ctx!.fillStyle = `rgba(254, 240, 138, ${glow})`;
				ctx!.font = '600 14px ui-sans-serif, system-ui, sans-serif';
				ctx!.textAlign = 'center';
				ctx!.fillText(highlight.name, p.x, p.y - r * 4.2);
			}
		}

		function shortestDelta(from: number, to: number) {
			return ((((to - from) % 360) + 540) % 360) - 180;
		}

		function frame() {
			requestAnimationFrame(frame);

			if (reducedMotion.matches) {
				if (!dirty) return;
				dirty = false;
				lon = targetLon;
				lat = targetLat;
				glow = highlight ? 1 : 0;
			} else {
				if (drifting) targetLon += 0.02;
				lon += shortestDelta(lon, targetLon) * 0.06;
				lat += (targetLat - lat) * 0.06;
				glow += ((highlight ? 1 : 0) - glow) * 0.12;
			}

			ctx!.clearRect(0, 0, width, height);
			drawStars(backgroundStars, false);
			drawStars(stars, false);
			drawSphereGrid();
			drawStars(backgroundStars, true);
			drawConstellations();
			drawStars(stars, true);
			drawHighlight();
		}

		const caption = document.getElementById('celestial-sphere-caption');

		// `recenter` spins the sphere to bring the star to the middle (used when a
		// card points at it). Hovering a star directly on the sphere lights it in
		// place instead, so it does not slide out from under the cursor.
		function focusStar(star: Star | null, recenter = true) {
			highlight = star;
			drifting = !star;
			dirty = true;
			if (caption) caption.style.opacity = star ? '0' : '1';
			if (star && recenter) {
				targetLon = star.ra * 15;
				targetLat = star.dec;
			} else if (!star) {
				targetLat = 0;
			}
		}

		// Stars tied to a project, hit-tested for hover and click on the sphere.
		const keyedStars = stars.filter((s) => s.key);

		function starAt(px: number, py: number) {
			let best: Star | null = null;
			let bestDist = Infinity;
			for (const star of keyedStars) {
				const p = project(star.ra, star.dec);
				if (p.depth <= 0) continue;
				const dist = Math.hypot(px - p.x, py - p.y);
				// Enlarged target: real stars are tiny and drifting.
				const reach = Math.max(14, starRadius(star.mag) * 3);
				if (dist <= reach && dist < bestDist) {
					bestDist = dist;
					best = star;
				}
			}
			return best;
		}

		let sphereHover: Star | null = null;
		canvas.addEventListener('pointermove', (event) => {
			const rect = canvas.getBoundingClientRect();
			const star = starAt(event.clientX - rect.left, event.clientY - rect.top);
			if (star === sphereHover) return;
			sphereHover = star;
			canvas.style.cursor = star ? 'pointer' : '';
			focusStar(star, false);
		});
		canvas.addEventListener('pointerleave', () => {
			sphereHover = null;
			canvas.style.cursor = '';
			focusStar(null);
		});
		canvas.addEventListener('click', (event) => {
			const rect = canvas.getBoundingClientRect();
			const star = starAt(event.clientX - rect.left, event.clientY - rect.top);
			if (!star?.key) return;
			const card = document.querySelector<HTMLElement>(
				`[data-star="${star.key}"]`,
			);
			if (!card) return;
			focusStar(star);
			card.scrollIntoView({
				behavior: reducedMotion.matches ? 'auto' : 'smooth',
				block: 'center',
			});
			card.querySelector('a')?.focus({ preventScroll: true });
		});

		// Repaint once when the user flips the reduced-motion setting.
		reducedMotion.addEventListener('change', () => {
			dirty = true;
		});

		for (const el of document.querySelectorAll<HTMLElement>('[data-star]')) {
			const star = starByKey.get(el.dataset.star!);
			if (!star) continue;
			el.addEventListener('mouseenter', () => focusStar(star));
			el.addEventListener('focus', () => focusStar(star));
			el.addEventListener('mouseleave', () => focusStar(null));
			el.addEventListener('blur', () => focusStar(null));
		}

		resize();
		new ResizeObserver(resize).observe(canvas);
		requestAnimationFrame(frame);
	}
</script>
